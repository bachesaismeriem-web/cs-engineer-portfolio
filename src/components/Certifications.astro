---
import { certificationsData } from '../data/certifications.ts';
---

<section id="certifications" class="reveal relative w-full bg-[#07020b] text-white py-16 px-6 md:px-12 font-sans overflow-hidden scroll-mt-24">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-pink-500 font-bold tracking-[0.2em] text-xs uppercase">{certificationsData.sectionTitle}</span>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-2 text-white">
          {certificationsData.heading}
        </h2>
        <p class="text-gray-400 text-sm mt-1">
          {certificationsData.subtitle}
        </p>
      </div>
    </div>

    <!-- Certifications Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      {certificationsData.certifications.map((cert) => (
        <div class="bg-[#0e0617]/80 border border-purple-900/40 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_25px_rgba(147,51,235,0.08)] hover:border-purple-500/50 transition-all duration-300 flex flex-col justify-between group">
          
          <div>
            <!-- Issuer & Status Header -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-semibold text-gray-400 tracking-wide uppercase">{cert.issuer}</span>
              <span class="text-[10px] font-mono text-pink-400 bg-purple-950/60 px-2 py-0.5 rounded-full border border-purple-500/20">
                {cert.status}
              </span>
            </div>

            <!-- Certification Title -->
            <h3 class="text-base font-bold text-white tracking-tight mb-2 group-hover:text-pink-300 transition-colors">
              {cert.title}
            </h3>

            <!-- Description -->
            <p class="text-xs text-gray-400 leading-relaxed mb-6">
              {cert.description}
            </p>
          </div>

          <!-- Bottom Tag -->
          <div>
            <span class="inline-block text-xs font-medium text-purple-300 bg-purple-900/20 border border-purple-500/20 px-3 py-1 rounded-full">
              {cert.tag}
            </span>
          </div>

        </div>
      ))}

    </div>

  </div>
</section>