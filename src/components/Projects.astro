---
import { experienceData } from "../data/projects";
---

<section id="experience" class="reveal relative w-full bg-[#07020b] text-white py-16 px-6 md:px-12 font-sans overflow-hidden scroll-mt-24">
  <div class="max-w-5xl mx-auto">
    
    <!-- Section Header -->
    <div class="mb-12">
      <span class="text-pink-500 font-bold tracking-[0.2em] text-xs uppercase">{experienceData.sectionTitle}</span>
      <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-2 text-white">
        {experienceData.heading}
      </h2>
      <p class="text-gray-400 text-sm mt-1">
        {experienceData.subtitle}
      </p>
    </div>

    <!-- Experience Timeline / Cards Layout -->
    <div class="relative pl-6 border-l border-purple-500/30 flex flex-col gap-10">
      
      {experienceData.experiences.map((item) => (
        <div class="relative group">
          <!-- Timeline Node Dot -->
          <div class="absolute -left-[33px] top-1.5 w-4 h-4 rounded-full bg-[#160b24] border-2 border-purple-500 shadow-[0_0_10px_rgba(168,85,247,0.5)] group-hover:scale-125 transition-transform"></div>

          <!-- Content Card -->
          <div class="bg-[#0e0617]/80 border border-purple-900/40 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_25px_rgba(147,51,235,0.08)] hover:border-purple-500/50 transition-all duration-300">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <div>
                <h3 class="text-lg font-bold text-white tracking-tight">
                  {item.role} <span class="text-pink-400">@ {item.company}</span> {item.location && <span class="text-gray-400 font-normal text-sm">({item.location})</span>}
                </h3>
              </div>
              <span class="text-xs font-mono text-pink-400 bg-purple-950/60 px-3 py-1 rounded-full border border-purple-500/20 w-fit">
                {item.period}
              </span>
            </div>

            <!-- Bullet Points or Description -->
            <ul class="list-disc list-inside space-y-1.5 text-sm text-gray-300">
              {item.description.map((desc) => (
                <li class="leading-relaxed">{desc}</li>
              ))}
            </ul>

            <!-- Badge Category -->
            <div class="mt-4 pt-3 border-t border-purple-950/60 flex items-center justify-between">
              <span class="text-[11px] font-medium text-purple-300 bg-purple-900/20 border border-purple-500/20 px-2.5 py-0.5 rounded-full">
                {item.type}
              </span>
            </div>

          </div>
        </div>
      ))}

    </div>

  </div>
</section>