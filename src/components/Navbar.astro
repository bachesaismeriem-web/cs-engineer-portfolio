---
---

<nav
  class="fixed left-1/2 top-4 z-50 w-[92%] max-w-6xl
         -translate-x-1/2 rounded-2xl
         border border-pink-500/20
         bg-[#0d0618]/80 backdrop-blur-xl"
>

  <div class="flex items-center justify-between gap-2 px-3 py-3 sm:px-5">

    <!-- Logo -->
    <a
      href="#home"
      class="flex items-center gap-2 font-bold"
    >
      <span class="text-lg text-pink-400 sm:text-xl">
        &lt;/&gt;
      </span>

      <span class="text-sm sm:text-base">
        Software Engineer
      </span>
    </a>


    <!-- Desktop Navigation -->
    <div class="hidden items-center gap-4 md:flex lg:gap-6">

      <a data-nav-link="home"
        href="#home"
        class="text-sm text-pink-400 transition hover:text-pink-300"
      >
        Home
      </a>

      <a data-nav-link="about"
        href="#about"
        class="text-sm text-zinc-400 transition hover:text-pink-400"
      >
        About
      </a>

      <a data-nav-link="skills"
        href="#skills"
        class="text-sm text-zinc-400 transition hover:text-pink-400"
      >
        Skills
      </a>

      <a data-nav-link="experience"
        href="#experience"
        class="text-sm text-zinc-400 transition hover:text-pink-400"
      >
        Professional Experience
      </a>

      <a data-nav-link="education"
        href="#education"
        class="text-sm text-zinc-400 transition hover:text-pink-400"
      >
        Education
      </a>

      <a data-nav-link="certifications"
        href="#certifications"
        class="text-sm text-zinc-400 transition hover:text-pink-400"
      >
        Certifications
      </a>

      <a data-nav-link="contact"
        href="#contact"
        class="text-sm text-zinc-400 transition hover:text-pink-400"
      >
        Contact
      </a>

    </div>


    <div class="flex items-center gap-2 md:hidden">
      <button type="button" class="nav-menu-button rounded-lg border border-purple-500/30 px-2.5 py-1.5 text-[10px] font-medium text-zinc-300 hover:border-pink-500/60 hover:text-pink-400" aria-expanded="false" aria-controls="mobile-navigation">
        Menu
      </button>
    </div>

    <div class="hidden items-center gap-2 md:hidden" id="mobile-navigation">
      <a
        href="#experience"
        class="rounded-lg border border-pink-500/30
               px-2 py-1.5 text-[10px] font-medium
               text-pink-300"
      >
        Internship
      </a>

      <a
        href="#contact"
        class="rounded-lg border border-purple-500/30
               px-2 py-1.5 text-[10px] font-medium
               text-zinc-300"
      >
        Contact
      </a>

      <a
        href="#certifications"
        class="rounded-lg border border-purple-500/30
               px-2 py-1.5 text-[10px] font-medium
               text-zinc-300"
      >
        Certs
      </a>
    </div>


  </div>

  <div class="nav-mobile-panel hidden border-t border-pink-500/15 px-3 pb-3 pt-2 md:hidden" id="mobile-navigation-panel">
    <div class="grid grid-cols-2 gap-2 text-xs">
      <a href="#home" data-mobile-nav-link="home" class="rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">Home</a>
      <a href="#about" data-mobile-nav-link="about" class="rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">About</a>
      <a href="#skills" data-mobile-nav-link="skills" class="rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">Skills</a>
      <a href="#experience" data-mobile-nav-link="experience" class="rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">Internship</a>
      <a href="#education" data-mobile-nav-link="education" class="rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">Education</a>
      <a href="#certifications" data-mobile-nav-link="certifications" class="rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">Certifications</a>
      <a href="#contact" data-mobile-nav-link="contact" class="col-span-2 rounded-lg px-3 py-2 text-zinc-300 hover:bg-pink-500/10 hover:text-pink-300">Contact</a>
    </div>
  </div>

</nav>

<script>
  const navigation = document.querySelector('nav');
  const menuButton = document.querySelector<HTMLButtonElement>('.nav-menu-button');
  const mobilePanel = document.querySelector<HTMLElement>('#mobile-navigation-panel');

  const closeMenu = () => {
    mobilePanel?.classList.add('hidden');
    menuButton?.setAttribute('aria-expanded', 'false');
  };

  menuButton?.addEventListener('click', () => {
    const isOpen = mobilePanel?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const sections = [...document.querySelectorAll<HTMLElement>('[id]')].filter((section) =>
    ['home', 'about', 'skills', 'experience', 'education', 'certifications', 'contact'].includes(section.id)
  );
  const setActive = (id: string) => {
    document.querySelectorAll<HTMLElement>('[data-nav-link], [data-mobile-nav-link]').forEach((link) => {
      link.classList.toggle('nav-link-active', link.getAttribute('href') === `#${id}`);
    });
  };

  const sectionObserver = new IntersectionObserver((entries) => {
    const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (visible) setActive(visible.target.id);
  }, { rootMargin: '-30% 0px -55% 0px', threshold: [0.1, 0.5] });

  sections.forEach((section) => sectionObserver.observe(section));
</script>