---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Message Sent | Software Engineer">
  <main class="flex min-h-screen items-center justify-center px-6 text-center">
    <section class="max-w-lg rounded-2xl border border-pink-500/30 bg-[#0e0617]/90 p-10 shadow-[0_0_35px_rgba(236,72,153,0.18)]">
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-pink-400">Message sent</p>
      <h1 class="text-3xl font-bold text-white">Thanks for reaching out.</h1>
      <p class="mt-4 text-zinc-400">Your message was submitted successfully. I will get back to you by email.</p>
      <a href="/" class="mt-8 inline-flex rounded-xl bg-gradient-to-r from-fuchsia-600 to-purple-600 px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90">Return to portfolio</a>
    </section>
  </main>
</Layout>
